{
  "name": "drawbridge-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DRAWBRIDGE Incident Room (synthetic, read-only screens) plus a separate operator-protected Airwallex sandbox screen",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "test:sandbox": "node --test \"tests/sandbox/*.test.ts\"",
    "test:agent": "node --test \"tests/agent/*.test.ts\"",
    "test:integrated": "node --test \"tests/integrated/**/*.test.ts\"",
    "reset:fixtures": "node scripts/reset-fixtures.mjs",
    "cleanroom": "npm run reset:fixtures && npm run typecheck && npm test && npm run build",
    "ui:baseline": "node scripts/ui-baseline.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
